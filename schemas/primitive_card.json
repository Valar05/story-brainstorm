{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrimitiveCard",
  "type": "object",
  "required": [
    "primitive_id",
    "family",
    "name",
    "summary",
    "observation",
    "inference",
    "pattern",
    "evidence",
    "rights_basis",
    "confidence",
    "schema_version"
  ],
  "properties": {
    "primitive_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "family": {
      "enum": [
        "story",
        "speech",
        "character",
        "conflict",
        "structure",
        "contextual"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "object",
      "required": [
        "setup",
        "pressure",
        "turn",
        "residue"
      ],
      "additionalProperties": false,
      "properties": {
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "pressure": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "residue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_id",
          "edition_url",
          "location",
          "short_excerpt",
          "excerpt_words"
        ],
        "properties": {
          "work_id": {
            "type": "string"
          },
          "edition_url": {
            "type": "string",
            "minLength": 8
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "short_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "excerpt_words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "additionalProperties": false
      }
    },
    "rights_basis": {
      "enum": [
        "PD_US_CONFIRMED"
      ]
    },
    "confidence": {
      "enum": [
        "accepted",
        "uncertain",
        "rejected"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "inference": {
      "type": "string",
      "minLength": 1
    },
    "subtype": {
      "type": "string",
      "enum": [
        "setting",
        "institution",
        "object",
        "transformation",
        "tone_pressure"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "contextual"
          }
        }
      },
      "then": {
        "required": [
          "subtype"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "not": {
              "const": "contextual"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "subtype"
          ]
        }
      }
    }
  ]
}
